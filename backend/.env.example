# Environment Variables - Backend
# Copy file ini ke .env dan isi nilainya

# Server
PORT=8080

# Database
# Format: host=... user=... password=... dbname=... port=... sslmode=...
# Default (cocok dengan docker-compose.yml):
DATABASE_URL=host=localhost user=postgres password=postgres dbname=chatbot port=5432 sslmode=disable

# Auth - ganti dengan string random minimal 32 karakter
JWT_SECRET=ganti-dengan-secret-yang-kuat-minimal-32-karakter

# AI - dapatkan di https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Widget runtime CORS
# Comma-separated browser origins that directly call /api/v1/widget/*.
# Keep localhost dev origins in code; add production widget app origin(s) here.
WIDGET_RUNTIME_ORIGINS=
